# ==========================================
# Stage 1: Build the frontend and compiled content
# ==========================================
FROM node:24-slim AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /workspace

# 1. Copy workspace configurations to root
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

# 2. Copy individual package.json files for aggressive dependency caching.
# This prevents cache invalidation and guarantees all dependencies (like esbuild) are fully installed.
COPY app/front-end/package.json ./app/front-end/
COPY package/generator/package.json ./package/generator/

# 3. Cache and install dependencies across the workspace using pnpm store
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# copy source code
COPY . .

# 5. Generate localized bundles
RUN pnpm locale make reference --prod

# 8. Build the highly optimized reference-front-end Vue 3.5 CSR application
RUN pnpm --filter @fuyeor/reference-front-end build

# 9. Compile Markdown/FON contents into static JSON artifacts
RUN pnpm --filter @fuyeor/reference-generator start

# 10. Generate multilingual sitemaps into dist/sitemaps
RUN pnpm --filter @fuyeor/reference-generator sitemap

# ==========================================
# Stage 2: Deploy and serve via Nginx
# ==========================================
FROM nginx:alpine AS runner

# Remove default static pages to keep the container clean
RUN rm -rf /usr/share/nginx/html/*

# 1. Copy the compiled Vue 3.5 SPA assets to the web root
COPY --from=builder /workspace/app/front-end/dist /usr/share/nginx/html

# 2. Copy the compiled content directly to /v1/content on disk.
COPY --from=builder /workspace/app/content /usr/share/nginx/html/v1/content

# 3. Inject custom Nginx config, ensuring SPA client routing compatibility and mapping .fon as application/json
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    include mime.types; \
    types { text/ffm ffm; } \
    index index.html; \
    location ^~ /v1/content/ { try_files $uri =404; } \
    location / { try_files $uri $uri/ /index.html; } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]